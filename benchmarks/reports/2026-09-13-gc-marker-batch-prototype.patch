+    #[tokio::test]
+    async fn dead_marker_batch_retries_cancellation_and_partial_commit() {
+        for fail_commit in [false, true] {
+            let directory = tempfile::tempdir().unwrap();
+            let fs = object_store::local::LocalFileSystem::new_with_prefix(directory.path())
+                .unwrap()
+                .with_fsync(true);
+            let durability = LocalDurability::new(fs.clone(), directory.path()).unwrap();
+            let objects: Arc<dyn ObjectStore> = Arc::new(fs);
+            let store = PackedChunks::open_with_initial_catalog(
+                objects.clone(),
+                Path::default(),
+                1,
+                0,
+                2,
+                Some(&PackedChunks::empty_state_catalog().unwrap()),
+                Some(durability.clone()),
+            )
+            .await
+            .unwrap();
+            let mut chunks = Vec::new();
+            for seed in 0..3 {
+                let (meta, bytes) = chunk(format!("dead batch {seed}").as_bytes());
+                store.put(meta.clone(), bytes.clone()).await.unwrap();
+                store.flush().await.unwrap();
+                chunks.push((meta, bytes));
+            }
+            let catalog = store.prepare_state_catalog().await.unwrap().unwrap();
+            store.finish_state_catalog(true).unwrap();
+            let deleted = chunks
+                .iter()
+                .map(|(meta, _)| meta.digest)
+                .collect::<HashSet<_>>();
+            let mut prepared = Vec::new();
+            let mut paths = Vec::new();
+            for (meta, _) in &chunks {
+                let old = store.location(&meta.digest).await.unwrap().unwrap().pack;
+                let marker = encode_replacement(old, None);
+                let path = sharded_path(
+                    &Path::default(),
+                    REPLACEMENTS_KIND,
+                    &Digest::from(blake3::hash(&marker)),
+                );
+                assert!(matches!(
+                    objects.head(&path).await,
+                    Err(object_store::Error::NotFound { .. })
+                ));
+                let PackCompaction::PreparedDead(pack) = store
+                    .compact_pack(old, &deleted, true, PayloadRetirement::Deferred)
+                    .await
+                    .unwrap()
+                else {
+                    panic!("expected staged local marker")
+                };
+                assert!(store.index.read().unwrap().packs.contains_key(&old));
+                assert!(matches!(
+                    objects.head(&path).await,
+                    Err(object_store::Error::NotFound { .. })
+                ));
+                paths.push(path);
+                prepared.push(pack);
+            }
+            if fail_commit {
+                // The first rename succeeds and the second fails. No index changes
+                // may escape, even though a prefix of the markers is now visible.
+                let obstacle = directory.path().join(paths[1].as_ref());
+                std::fs::create_dir(&obstacle).unwrap();
+                assert!(store.commit_dead_pack_markers(prepared).await.is_err());
+                assert!(objects.head(&paths[0]).await.is_ok());
+                std::fs::remove_dir(obstacle).unwrap();
+            } else {
+                // Dropping staged work models cancellation before group commit.
+                drop(prepared);
+            }
+            assert_eq!(store.dirty_packs.lock().await.len(), 3);
+            assert_eq!(store.index.read().unwrap().packs.len(), 3);
+            let reopened = PackedChunks::open_with_initial_catalog(
+                objects.clone(),
+                Path::default(),
+                1,
+                0,
+                2,
+                Some(&catalog),
+                Some(durability),
+            )
+            .await
+            .unwrap();
+            for (meta, bytes) in &chunks {
+                assert_eq!(
+                    reopened.get(&meta.digest).await.unwrap(),
+                    Some(bytes.clone())
+                );
+            }
+            store.deleted.lock().await.extend(deleted.iter().copied());
+            store
+                .finish_deletions_inner(true, PayloadRetirement::Deferred)
+                .await
+                .unwrap();
+            assert!(store.dirty_packs.lock().await.is_empty());
+            assert!(store.index.read().unwrap().packs.is_empty());
+            for path in paths {
+                assert!(objects.head(&path).await.is_ok());
+            }
+        }
     }


     #[tracing::instrument(name = "blob.pack.compact", skip_all)]
+    async fn commit_dead_pack_markers(&self, prepared: Vec<PreparedDeadPack>) -> io::Result<()> {
+        let _phase = crate::repository::CollectionPhase::new("compact_pack_marker_commit");
+        let (packs, markers): (Vec<_>, Vec<_>) = prepared
+            .into_iter()
+            .map(|pack| ((pack.old, pack.retired), pack.marker))
+            .unzip();
+        self.local_durability
+            .as_ref()
+            .expect("only local compaction prepares markers")
+            .commit(markers)
+            .await?;
+        let mut retry = self.dirty_packs.lock().await;
+        for (old, retired) in packs {
+            self.apply_dead_pack(old, retired);
+            retry.remove(&old);
+        }
+        Ok(())
+    }
+
+    fn apply_dead_pack(&self, old: PackId, retired: Option<Path>) {
+        let mut index = self.index.write().unwrap();
+        let tombstone_records = index
+            .tombstone_records
+            .get(&old)
+            .cloned()
+            .unwrap_or_default();
+        index.remove_pack(old);
+        self.record_pack_mutation(old);
+        let mut pending = self.pending_catalog.lock().unwrap();
+        pending.retirements.extend(retired);
+        for record in index.unreferenced_tombstone_records(tombstone_records) {
+            pending
+                .retirements
+                .insert(sharded_path(&self.base, TOMBSTONES_KIND, &record));
+            self.read_counters
+                .gc_tombstone_delete_requests
+                .fetch_add(1, Ordering::Relaxed);
+        }
+        self.index_dirty.store(true, Ordering::Release);
+        drop(pending);
+        drop(index);
+        self.cache.lock().unwrap().remove(old);
+    }

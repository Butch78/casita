@@ -575,0 +607,57 @@ mod tests {
+    #[tokio::test]
+    async fn bounded_reads_preserve_eof_and_stream_after_stale_size_hints() {
+        use tokio::io::AsyncReadExt;
+        let temp = tempfile::tempdir().unwrap();
+        let path = temp.path().join("data");
+        for size in [
+            0,
+            1,
+            SMALL_FILE_READ_LIMIT - 1,
+            SMALL_FILE_READ_LIMIT,
+            SMALL_FILE_READ_LIMIT + 1,
+            SMALL_FILE_READ_LIMIT * 2 + 13,
+        ] {
+            let bytes: Vec<_> = (0..size).map(|i| (i % 251) as u8).collect();
+            std::fs::write(&path, &bytes).unwrap();
+            // A file may grow or shrink between fstat and the read. A stale
+            // hint must never truncate the payload or lose a buffered prefix.
+            for hint in [0, size as u64, (SMALL_FILE_READ_LIMIT + 1) as u64] {
+                let contents =
+                    read_file_contents(std::fs::File::open(&path).unwrap(), hint).unwrap();
+                let actual = match contents {
+                    FileContents::Buffered(bytes) => bytes,
+                    FileContents::Streaming { prefix, file } => {
+                        assert!(prefix.len() <= SMALL_FILE_READ_LIMIT + 1);
+                        let mut bytes = Vec::new();
+                        prefix
+                            .as_slice()
+                            .chain(file)
+                            .read_to_end(&mut bytes)
+                            .await
+                            .unwrap();
+                        bytes
+                    }
+                };
+                assert_eq!(actual, bytes, "size={size}, hint={hint}");
+            }
+        }
+    }
+
+    #[cfg(unix)]
+    #[tokio::test]
+    async fn buffered_opens_refuse_links_directories_and_fifos() {
+        let temp = tempfile::tempdir().unwrap();
+        std::fs::write(temp.path().join("data"), b"private").unwrap();
+        std::os::unix::fs::symlink("data", temp.path().join("link")).unwrap();
+        rustix::fs::mkfifoat(
+            rustix::fs::CWD,
+            temp.path().join("fifo"),
+            rustix::fs::Mode::RUSR | rustix::fs::Mode::WUSR,
+        )
+        .unwrap();
+        let root = FsRoot::open_read(temp.path()).await.unwrap();
+        for name in ["link", "fifo", "."] {
+            assert!(root.open_file(name).await.is_err(), "{name}");
+        }
+    }

diff --git a/src/fs_root.rs b/src/fs_root.rs
index b07928d..5cf0d77 100644
--- a/src/fs_root.rs
+++ b/src/fs_root.rs
@@ -45,0 +46,32 @@ pub(crate) struct FsRoot {
+/// Largest fully buffered file. One extra byte detects growth into streaming.
+pub(crate) const SMALL_FILE_READ_LIMIT: usize = 256 * 1024;
+
+pub(crate) enum FileContents {
+    Buffered(Vec<u8>),
+    Streaming {
+        prefix: Vec<u8>,
+        file: tokio::fs::File,
+    },
+}
+
+/// Read through EOF in the open task when the size hint is small. The extra
+/// byte distinguishes EOF from a file that grew past the bounded read window.
+/// In that case the caller consumes the prefix and resumes the same open file.
+fn read_file_contents(mut file: std::fs::File, size_hint: u64) -> Result<FileContents, Error> {
+    use std::io::Read;
+    let mut prefix = Vec::new();
+    if size_hint <= SMALL_FILE_READ_LIMIT as u64 {
+        prefix.reserve(size_hint as usize + 1);
+        file.by_ref()
+            .take(SMALL_FILE_READ_LIMIT as u64 + 1)
+            .read_to_end(&mut prefix)?;
+        if prefix.len() <= SMALL_FILE_READ_LIMIT {
+            return Ok(FileContents::Buffered(prefix));
+        }
+    }
+    Ok(FileContents::Streaming {
+        prefix,
+        file: tokio::fs::File::from_std(file),
+    })
+}
+
